# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter companion app (pedebook_app)
/pedebook_app/.dart_tool/
/pedebook_app/.flutter-plugins-dependencies
/pedebook_app/.pub-cache/
/pedebook_app/.pub/
/pedebook_app/build/
/pedebook_app/.idea/
/pedebook_app/*.iml
/pedebook_app/android/app/debug/
/pedebook_app/android/app/profile/
/pedebook_app/android/app/release/
/pedebook_app/android/local.properties
/pedebook_app/windows/flutter/ephemeral/

